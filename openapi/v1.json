  "components": {
    "schemas": {
      "AdCreative": {
        "required": [
          "id",
          "advertiserId",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "advertiserId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "versionLabel": {
            "type": [
              "null",
              "string"
            ]
          },
          "fileRef": {
            "type": [
              "null",
              "string"
            ]
          },
          "fingerprintData": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          },
          "fingerprintDurationSec": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "Advertiser": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "agencyId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "Agency": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "BootstrapAdminRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "Contract": {
        "required": [
          "id",
          "advertiserId",
          "stationId",
          "creativeId",
          "startDate",
          "endDate",
          "daypartStart",
          "daypartEnd",
          "contractedFrequency",
          "contractedDurationSec"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "advertiserId": {
            "type": "string",
            "format": "uuid"
          },
          "stationId": {
            "type": "string",
            "format": "uuid"
          },
          "creativeId": {
            "type": "string",
            "format": "uuid"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "daypartStart": {
            "type": "string",
            "format": "time"
          },
          "daypartEnd": {
            "type": "string",
            "format": "time"
          },
          "contractedFrequency": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "contractedDurationSec": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CreateAdCreativeRequest": {
        "required": [
          "advertiserId",
          "name",
          "versionLabel",
          "fileRef",
          "fingerprintData",
          "fingerprintDurationSec"
        ],
        "type": "object",
        "properties": {
          "advertiserId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "versionLabel": {
            "type": [
              "null",
              "string"
            ]
          },
          "fileRef": {
            "type": [
              "null",
              "string"
            ]
          },
          "fingerprintData": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          },
          "fingerprintDurationSec": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CreateAdvertiserRequest": {
        "required": [
          "name",
          "agencyId"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "agencyId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "CreateAdvertiserUserRequest": {
        "required": [
          "email",
          "password",
          "advertiserId"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "advertiserId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateAgencyRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateContractRequest": {
        "required": [
          "advertiserId",
          "stationId",
          "creativeId",
          "startDate",
          "endDate",
          "daypartStart",
          "daypartEnd",
          "contractedFrequency",
          "contractedDurationSec"
        ],
        "type": "object",
        "properties": {
          "advertiserId": {
            "type": "string",
            "format": "uuid"
          },
          "stationId": {
            "type": "string",
            "format": "uuid"
          },
          "creativeId": {
            "type": "string",
            "format": "uuid"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "daypartStart": {
            "type": "string",
            "format": "time"
          },
          "daypartEnd": {
            "type": "string",
            "format": "time"
          },
          "contractedFrequency": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
